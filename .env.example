# ==========================================================================
# Sistema de Asistencia Universitaria
# Copia este archivo a ".env" y ajusta los valores.
# ==========================================================================

# Seguridad (¡obligatorio cambiarlo en producción!)
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-value

# QR dinámico: vida del token en segundos (rango permitido 30-60)
QR_TOKEN_TTL_SECONDS=45

# GPS: precisión máxima aceptada en metros
GPS_MAX_ACCURACY=25

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=https://asistencia.local

# Credenciales del administrador inicial (se crean en la primer migración/siembra)
ADMIN_EMAIL=admin@universidad.edu
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Administrador del Sistema
ADMIN_PASSWORD=Admin123!

# Directorio con los certificados TLS para nginx (server.crt / server.key)
CERT_DIR=./certs
