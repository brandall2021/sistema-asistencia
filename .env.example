# ==========================================================================
# Sistema de Asistencia Universitaria
# Copia este archivo a ".env" y ajusta los valores.
# En producción el backend se NEGARÁ a iniciar si estos valores son inseguros
# (JWT por defecto/corto, contraseñas por defecto, CORS con localhost/comodines).
# ==========================================================================

# --------------------------------------------------------------------------
# Seguridad (OBLIGATORIO en producción)
# --------------------------------------------------------------------------
# Clave de firma JWT: mínimo 32 bytes, aleatoria. Ejemplo para generarla:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-with-a-long-random-value-of-at-least-32-bytes

# Contraseña del administrador inicial (no usar el valor por defecto)
ADMIN_PASSWORD=CambiaEstaContrasena1!
ADMIN_EMAIL=admin@universidad.edu
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Administrador del Sistema

# Contraseña de PostgreSQL (no usar el valor por defecto)
POSTGRES_PASSWORD=postgres_super_secreta

# Orígenes CORS permitidos (separados por coma). En producción no usar
# localhost ni comodines.
CORS_ORIGINS=https://asistencia.tudominio.com

# Proxies confiables (IP o CIDR separados por coma). Solo desde estas IPs se
# acepta X-Forwarded-For para el rate limiting (ej. subred Docker de compose).
TRUSTED_PROXIES=172.16.0.0/12

# Cookie HttpOnly del refresh token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax

# --------------------------------------------------------------------------
# Opcionales
# --------------------------------------------------------------------------
# QR dinámico: vida del token en segundos (rango permitido 30-60)
QR_TOKEN_TTL_SECONDS=45

# GPS: precisión máxima aceptada en metros
GPS_MAX_ACCURACY=25

# Ticket de un solo uso para WebSocket (segundos)
WS_TICKET_TTL_SECONDS=30

# Directorio con los certificados TLS para nginx (server.crt / server.key)
CERT_DIR=./certs
